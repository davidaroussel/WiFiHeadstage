    .Z(F0));
  ffsre20001 \Controller_inst/int_STM32_TX_DV_c ( .D0(DI1_dly), .SP(CE_dly), 
    .CK(CLK_dly), .LSR(LSR_dly), .Q(Q1));

  specify
