module lut40054 ( input A, B, C, D, output Z );

  LUT4 #("0x1444") INST10( .A(A), .B(B), .C(C), .D(D), .Z(Z));
endmodule

module lut40055 ( input A, B, C, D, output Z );

  LUT4 #("0x0304") INST10( .A(A), .B(B), .C(C), .D(D), .Z(Z));
endmodule

